// --------------------------------------------------------------------------
// Bizonix Backend — Prisma Schema
// Database: PostgreSQL 16 / bizonix
// --------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTH & RBAC
// ═══════════════════════════════════════════════════════════════════════════

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  username         String?    @unique
  passwordHash     String     @map("password_hash")
  displayName      String?    @map("display_name")
  status           UserStatus @default(ACTIVE)
  welcomeEmailSent Boolean    @default(false) @map("welcome_email_sent")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  userRoles       UserRole[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]

  heroPublishStatesUpdated HomeHeroPublishState[] @relation("PublishStateUpdatedBy")
  assignedEnquiries        Enquiry[]              @relation("AssignedEnquiries")
  enquiryNotes             EnquiryNote[]          @relation("EnquiryNoteAuthor")
  enquiryActivities        EnquiryActivity[]      @relation("EnquiryActivityActor")
  sentEnquiryEmails        EnquiryEmail[]         @relation("EnquiryEmailSender")

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetOtp {
  id         String   @id @default(uuid())
  email      String
  otpHash    String   @map("otp_hash")
  resetToken String?  @unique @map("reset_token")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_otps")
}


// ═══════════════════════════════════════════════════════════════════════════
// AUDIT
// ═══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([resourceType])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// SITE SETTINGS
// ═══════════════════════════════════════════════════════════════════════════

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// HOME HERO
// ═══════════════════════════════════════════════════════════════════════════

enum HeroStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model HomeHeroVariant {
  id          String     @id @default(uuid())
  key         String     @unique
  name        String
  description String?
  status      HeroStatus @default(DRAFT)
  config      Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  publishedStates HomeHeroPublishState[] @relation("PublishedVariant")
  draftStates     HomeHeroPublishState[] @relation("DraftVariant")

  @@index([status])
  @@map("home_hero_variants")
}

model HomeHeroPublishState {
  id                 String    @id @default("singleton")
  publishedVariantId String?   @map("published_variant_id")
  draftVariantId     String?   @map("draft_variant_id")
  updatedByUserId    String?   @map("updated_by_user_id")
  publishedAt        DateTime? @map("published_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  publishedVariant HomeHeroVariant? @relation("PublishedVariant", fields: [publishedVariantId], references: [id], onDelete: SetNull)
  draftVariant     HomeHeroVariant? @relation("DraftVariant", fields: [draftVariantId], references: [id], onDelete: SetNull)
  updatedBy        User?            @relation("PublishStateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("home_hero_publish_state")
}

// ═══════════════════════════════════════════════════════════════════════════
// FAQS (CMS)
// ═══════════════════════════════════════════════════════════════════════════

enum FaqLocation {
  HOME
  BOOK_DEMO
  MODULE
}

model FaqCategory {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  location    FaqLocation @default(HOME)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  faqs        FaqItem[]

  @@index([location, sortOrder])
  @@map("faq_categories")
}

model FaqItem {
  id          String       @id @default(uuid())
  question    String
  answer      String       @db.Text
  tag         String?
  location    FaqLocation  @default(HOME)
  categoryId  String?      @map("category_id")
  moduleId    String?      @map("module_id")
  sortOrder   Int          @default(0) @map("sort_order")
  isPublished Boolean      @default(true) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  category    FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  module      ModuleItem?  @relation("ModuleFaqs", fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([location, isPublished, sortOrder])
  @@index([moduleId])
  @@map("faq_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULES & SOLUTIONS (CMS)
// ═══════════════════════════════════════════════════════════════════════════

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModuleThemeKey {
  CYAN
  ORANGE
  CORAL
  EMERALD
  BLUE
  PURPLE
  PINK
  INDIGO
  SLATE
}

enum ModuleIconKey {
  BOXES
  TRUCK
  SCAN_BARCODE
  BUILDING
  STORE
  CALCULATOR
  SHOPPING_BAG
  BAR_CHART
  SHIELD_CHECK
  LAYERS
  CPU
  WORKFLOW
  DATABASE
  ZAP
}

model ModuleItem {
  id              String         @id @default(uuid())
  slug            String         @unique
  title           String
  category        String
  summary         String         @db.Text
  outcome         String         @db.Text
  themeKey        ModuleThemeKey @default(BLUE) @map("theme_key")
  iconKey         ModuleIconKey  @default(BOXES) @map("icon_key")
  badge           String?
  sortOrder       Int            @default(0) @map("sort_order")
  status          ModuleStatus   @default(DRAFT)

  everPublished   Boolean        @default(false) @map("ever_published")
  version         Int            @default(1)
  contentVersion  Int            @default(1) @map("content_version")

  showInCatalog   Boolean        @default(true) @map("show_in_catalog")
  showInMegaMenu  Boolean        @default(false) @map("show_in_mega_menu")
  showInHomepage  Boolean        @default(false) @map("show_in_homepage")
  showInFooter    Boolean        @default(false) @map("show_in_footer")

  content         Json           @default("{}")

  faqs            FaqItem[]      @relation("ModuleFaqs")

  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@index([category])
  @@map("module_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// INDUSTRIES (CMS)
// ═══════════════════════════════════════════════════════════════════════════

enum IndustryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IndustryAccent {
  BLUE
  TEAL
  VIOLET
}

model IndustryItem {
  id              String         @id @default(uuid())
  slug            String         @unique
  name            String
  category        String
  summary         String         @db.Text
  accent          IndustryAccent @default(BLUE)
  badge           String?
  sortOrder       Int            @default(0) @map("sort_order")
  status          IndustryStatus @default(DRAFT)

  everPublished   Boolean        @default(false) @map("ever_published")
  version         Int            @default(1)
  contentVersion  Int            @default(1) @map("content_version")

  showInOverview  Boolean        @default(true) @map("show_in_overview")
  showInMegaMenu  Boolean        @default(false) @map("show_in_mega_menu")
  showInHomepage  Boolean        @default(false) @map("show_in_homepage")
  showInFooter    Boolean        @default(false) @map("show_in_footer")

  content         Json           @default("{}")

  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@index([category])
  @@map("industry_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════════════════════════════════

model NavigationGroup {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items NavigationItem[]

  @@index([isActive, sortOrder])
  @@map("navigation_groups")
}

model NavigationItem {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  label       String
  description String?
  href        String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group NavigationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@map("navigation_items")
}

model NavigationConfig {
  id           String   @id @default("singleton")
  announcement Json     @default("{}")
  header       Json     @default("{}")
  megaMenu     Json     @default("{}")
  footer       Json     @default("{}")
  footerCta    Json     @default("{}")
  bottomBar    Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("navigation_configs")
}


// ═══════════════════════════════════════════════════════════════════════════
// PRICING
// ═══════════════════════════════════════════════════════════════════════════

enum PricingMode {
  CONTACT_SALES
  FIXED_PRICE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PricingPlan {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  audience      String?
  shortAudience String?       @map("short_audience")
  pricingMode   PricingMode   @default(CONTACT_SALES) @map("pricing_mode")
  monthlyPrice  Decimal?      @map("monthly_price") @db.Decimal(12, 2)
  annualPrice   Decimal?      @map("annual_price") @db.Decimal(12, 2)
  currency      String        @default("INR")
  note          String?
  sortOrder     Int           @default(0) @map("sort_order")
  isFeatured    Boolean       @default(false) @map("is_featured")
  badge         String?
  status        ContentStatus @default(PUBLISHED)
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  planFeatures PricingPlanFeature[]

  @@index([slug])
  @@index([status])
  @@map("pricing_plans")
}

model PricingFeature {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planFeatures PricingPlanFeature[]

  @@map("pricing_features")
}

model PricingPlanFeature {
  id           String  @id @default(uuid())
  planId       String  @map("plan_id")
  featureId    String  @map("feature_id")
  included     Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")
  metadata     Json?

  plan    PricingPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PricingFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("pricing_plan_features")
}

model PricingAddon {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  description  String?
  tags         String[]      @default([])
  billingType  String?       @map("billing_type")
  pricingMode  PricingMode   @default(CONTACT_SALES) @map("pricing_mode")
  price        Decimal?      @db.Decimal(12, 2)
  currency     String        @default("INR")
  displayOrder Int           @default(0) @map("display_order")
  status       ContentStatus @default(PUBLISHED)
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("pricing_addons")
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULES
// ═══════════════════════════════════════════════════════════════════════════

model Module {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  shortDescription String?       @map("short_description")
  longDescription  String?       @map("long_description")
  outcome          String?
  capabilities     String[]      @default([])
  accent           String?
  sortOrder        Int           @default(0) @map("sort_order")
  isVisible        Boolean       @default(true) @map("is_visible")
  status           ContentStatus @default(PUBLISHED)
  route            String?
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status, sortOrder])
  @@map("modules")
}

// ═══════════════════════════════════════════════════════════════════════════
// INDUSTRIES
// ═══════════════════════════════════════════════════════════════════════════

model Industry {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  heroContent    Json?         @map("hero_content")
  capabilities   Json?
  accent         String?
  sortOrder      Int           @default(0) @map("sort_order")
  isVisible      Boolean       @default(true) @map("is_visible")
  status         ContentStatus @default(PUBLISHED)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status, sortOrder])
  @@map("industries")
}

// ═══════════════════════════════════════════════════════════════════════════
// CUSTOMERS & PARTNERS
// ═══════════════════════════════════════════════════════════════════════════

model Customer {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  industry    String?
  logoUrl     String?       @map("logo_url")
  sortOrder   Int           @default(0) @map("sort_order")
  isPublished Boolean       @default(false) @map("is_published")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([isPublished])
  @@map("customers")
}

model Partner {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  category    String    @default("Technology Partner")
  websiteUrl  String?   @map("website_url")
  description String?
  logoUrl     String?   @map("logo_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isFeatured  Boolean   @default(true) @map("is_featured")
  isPublished Boolean   @default(true) @map("is_published")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([sortOrder])
  @@map("partners")
}

// ═══════════════════════════════════════════════════════════════════════════
// FAQ
// ═══════════════════════════════════════════════════════════════════════════

model FAQ {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String   @default("general")
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category, displayOrder])
  @@index([isPublished])
  @@map("faqs")
}

// ═══════════════════════════════════════════════════════════════════════════
// SEO
// ═══════════════════════════════════════════════════════════════════════════

model SeoPage {
  id            String   @id @default(uuid())
  route         String   @unique
  title         String?
  description   String?
  canonical     String?
  ogTitle       String?  @map("og_title")
  ogDescription String?  @map("og_description")
  ogImage       String?  @map("og_image")
  robotsIndex   Boolean  @default(true) @map("robots_index")
  robotsFollow  Boolean  @default(true) @map("robots_follow")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("seo_pages")
}

// --------------------------------------------------------------------------
// ENQUIRIES & LEAD INTAKE
// --------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  FOLLOW_UP
  CONVERTED
  CLOSED
  SPAM
}

enum EnquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Enquiry {
  id              String          @id @default(uuid())
  fullName        String          @map("full_name")
  companyName     String          @map("company_name")
  email           String
  phone           String?
  city            String?
  outletCount     String?         @map("outlet_count")
  currentSoftware String?         @map("current_software")
  role            String?
  industry        String?
  priorities      String[]        @default([])
  timeline        String?
  intent          String?         @default("Book a Demo")
  source          String?         @default("Website")
  page            String?         @default("/contact")
  message         String?         @db.Text
  status          EnquiryStatus   @default(NEW)
  priority        EnquiryPriority @default(MEDIUM)
  leadScore       Int             @default(0) @map("lead_score")
  assignedToId    String?         @map("assigned_to_id")
  nextAction      String?         @map("next_action")
  demoDate        DateTime?       @map("demo_date")
  metadata        Json?           @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  assignedTo User?             @relation("AssignedEnquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      EnquiryNote[]
  activities EnquiryActivity[]
  emails     EnquiryEmail[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("enquiries")
}

enum EnquiryEmailDirection {
  OUTBOUND
  INBOUND
}

enum EnquiryEmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model EnquiryEmail {
  id             String                     @id @default(uuid())
  enquiryId      String                     @map("enquiry_id")
  senderUserId   String?                    @map("sender_user_id")
  direction      EnquiryEmailDirection
  recipient      String
  subject        String
  body           String                     @db.Text
  providerId     String?                    @map("provider_id")
  deliveryStatus EnquiryEmailDeliveryStatus @default(QUEUED) @map("delivery_status")
  errorMessage   String?                    @map("error_message") @db.Text
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  enquiry    Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderUser User?   @relation("EnquiryEmailSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@index([deliveryStatus])
  @@map("enquiry_emails")
}

model EnquiryNote {
  id        String   @id @default(uuid())
  enquiryId String   @map("enquiry_id")
  authorId  String   @map("author_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User    @relation("EnquiryNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("enquiry_notes")
}

model EnquiryActivity {
  id          String   @id @default(uuid())
  enquiryId   String   @map("enquiry_id")
  actorId     String?  @map("actor_id")
  type        String
  description String
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor   User?   @relation("EnquiryActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([createdAt])
  @@map("enquiry_activities")
}

